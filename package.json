{
  "name": "m365-copilot-proxy",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @m365-copilot/proxy dev",
    "build": "pnpm -r build",
    "proxy": "node packages/proxy/bin/m365-proxy.mjs",
    "m365-personal": "node packages/core/dist/app/personal-cli.mjs",
    "pi": "bash scripts/pi-local.sh",
    "test": "pnpm test:unit",
    "test:unit": "pnpm build && npx vitest run",
    "test:live": "pnpm build && M365_LIVE=1 npx vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:boundaries": "node scripts/adapter-boundaries.ts --check",
    "lint:boundaries:baseline": "node scripts/adapter-boundaries.ts --write-baseline",
    "snapshot:exports": "pnpm --filter @m365-copilot/core build && node scripts/core-export-snapshot.ts --write",
    "snapshot:exports:check": "node scripts/core-export-snapshot.ts --check"
  },
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "tsdown": "^0.21.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
